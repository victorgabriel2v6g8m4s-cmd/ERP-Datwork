{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "typecheck:shared": "tsc -p tsconfig.shared.json",
    "typecheck:recipes": "tsc -p tsconfig.recipes.json",
    "typecheck:pricing": "tsc -p tsconfig.pricing.json",
    "typecheck:expenses": "tsc -p tsconfig.expenses.json",
    "typecheck:agenda": "tsc -p tsconfig.agenda.json",
    "build:bundle": "vite build",
    "build": "npm run typecheck && npm run build:bundle",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "axios": "^1.18.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "allowScripts": {
    "fsevents": false
  }
}
